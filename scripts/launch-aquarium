#!/usr/bin/env bash
set -euo pipefail

plugin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
renderer="$plugin_dir/scripts/aquarium.py"
integration_helper="$plugin_dir/scripts/idle-integration"

# Omarchy's idle service identifies screensavers through this application id.
mode=${1:-}

# Omarchy's first-party idle service and toggle store hardcode this path
# regardless of XDG_STATE_HOME; match it exactly so this check observes the
# same state Omarchy itself does.
stay_awake_state="$HOME/.local/state/omarchy/indicators/stay-awake"
current_uid=$(id -u)

screensaver_process_running() {
  # Scope to the invoking user: an unscoped `pgrep -f` would also match a
  # different local user's process that merely contains this application id
  # in its own command line, letting them silently suppress our launches.
  pgrep -u "$current_uid" -f '[o]rg.omarchy.screensaver' >/dev/null 2>&1
}

screensaver_window_open() {
  # hyprctl only ever talks to the invoking user's own compositor instance,
  # so this check is inherently scoped to the current session.
  command -v hyprctl >/dev/null 2>&1 || return 1
  command -v jq >/dev/null 2>&1 || return 1
  hyprctl clients -j 2>/dev/null | jq -e 'any(.[]?; .class == "org.omarchy.screensaver")' >/dev/null 2>&1
}

if screensaver_process_running || screensaver_window_open; then
  exit 0
fi

if [[ $mode != force ]]; then
  # The QML service watches this state too. Check again here so a delayed
  # file watcher cannot start automatic immersion after the user selects
  # Keep Awake. Keep Awake only suppresses automatic immersion.
  if [[ $mode == automatic && -f $stay_awake_state ]]; then
    exit 0
  fi
  # A screensaver-off toggle Omarcharium does not own means the user (or
  # another tool) explicitly disabled the stock saver; respect that for
  # anything but a manual, forced launch. Automatic launches additionally
  # require owned suppression, or they could overlap the stock saver.
  status=$(bash "$integration_helper" status 2>/dev/null) || status=user-disabled
  if [[ $status == user-disabled || ( $mode == automatic && $status != owned ) ]]; then
    exit 0
  fi
fi

terminal=$(xdg-terminal-exec --print-id)
focused=$(omarchy-hyprland-monitor-focused)

case "$terminal" in
  *Alacritty*|*ghostty*|*foot*|*kitty*) ;;
  *)
    omarchy-notification-send -g '><>' "Omarcharium needs Alacritty, Foot, Ghostty, or Kitty"
    exit 1
    ;;
esac

hypr_focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 \
    || hyprctl dispatch focusmonitor "$1" >/dev/null
}

hypr_exec() {
  local command
  printf -v command '%q ' "$@"
  hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1 \
    || hyprctl dispatch exec -- bash -lc "$command" >/dev/null
}

socket="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
exec {events}< <(socat -U - "UNIX-CONNECT:$socket")

wait_for_window() {
  local line deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)) && IFS= read -r -t "$((deadline - SECONDS))" -u "$events" line; do
    [[ $line == openwindow\>\>*,org.omarchy.screensaver,* ]] && return 0
  done
}

for monitor in $(hyprctl monitors -j | jq -r '.[].name'); do
  hypr_focus_monitor "$monitor"
  case "$terminal" in
    *Alacritty*)
      hypr_exec alacritty --class=org.omarchy.screensaver \
        --config-file "$OMARCHY_PATH/default/alacritty/screensaver.toml" \
        -e python3 "$renderer"
      ;;
    *ghostty*)
      hypr_exec ghostty --class=org.omarchy.screensaver \
        --config-file="$OMARCHY_PATH/default/ghostty/screensaver" \
        --font-size=16 -e python3 "$renderer"
      ;;
    *foot*)
      hypr_exec foot --app-id=org.omarchy.screensaver \
        --config="$OMARCHY_PATH/default/foot/screensaver.ini" \
        -e python3 "$renderer"
      ;;
    *kitty*)
      hypr_exec kitty --class=org.omarchy.screensaver \
        --override font_size=16 --override window_padding_width=0 \
        -e python3 "$renderer"
      ;;
  esac
  wait_for_window
 done

hypr_focus_monitor "$focused"
